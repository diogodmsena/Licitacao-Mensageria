# Porta do Servidor (Padrão: 3000)
PORT=3000

# Chave de API para proteger o endpoint /api/enviar-mensagem
API_KEY=sua_chave_secreta_aqui

# Origem permitida para o CORS (ex: http://meusistema.com.br ou * para liberar todas)
CORS_ORIGIN=*

# Fuso horário padrão para interpretação de datas de agendamento sem offset explícito
TZ=America/Sao_Paulo

# (Opcional) URL base do Webrun/Maker caso queira enviar caminhos relativos nos agendamentos
# Exemplo: http://localhost:8080/webrun
MAKER_BASE_URL=

# Tempo limite (ms) para aguardar resposta HTTP do fluxo do Maker (Padrão: 30000)
MAKER_WEBHOOK_TIMEOUT_MS=30000
